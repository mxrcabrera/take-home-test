# ─── Backend (override appsettings.json via environment variables) ─────────────

# SQL Server connection string
ConnectionStrings__DefaultConnection=Server=localhost,1433;Database=LoanManagementDb;User Id=sa;Password=YourStrong@Passw0rd;TrustServerCertificate=True;

# JWT configuration (key must be at least 32 characters)
Jwt__Key=YourSuperSecretKeyAtLeast32CharactersLong!!
Jwt__Issuer=LoanManagementAPI
Jwt__Audience=LoanManagementClient

# ─── Frontend (configured via src/environments/, not env vars at runtime) ─────
# API base URL: edit src/environments/environment.ts and environment.development.ts